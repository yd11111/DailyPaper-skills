# 内层 Obsidian vault 自带 git 仓库，外层不跟踪
DailyPaper/

# 运行时日志
*.log
scripts/*.log

# Python 编译产物
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Claude Code 本地覆盖配置（环境特异）
.claude/settings.local.json
.claude/*.local.json

# 临时 / 缓存
/tmp/
*.tmp
*.swp

# 论文资源本地化缓存（PDF / HTML / GitHub clone），不进 git
# 详见 ~/DailyPaper/skills/paper-reader/references/no-hallucination-rules.md §11.5
.cache/

# Playwright MCP 运行时产物（console log / page 快照），工具临时文件不进 git
.playwright-mcp/
